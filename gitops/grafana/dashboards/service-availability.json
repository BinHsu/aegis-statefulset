{
  "__comment": "Service availability dashboard for chaos demo evidence (Phase 1 + Phase 2). Provides probe_success continuous timeline, ALB HealthyHostCount, active alerts panel, pod readiness count, and dashboard annotations for chaos events. Intended to be displayed during the demo so reviewers can see the dip-and-recover signature on a single canvas. Datasource UIDs are environment-specific; keep ${DS_*} variables and resolve at provisioning time.",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "${DS_PROMETHEUS}",
        "enable": true,
        "iconColor": "red",
        "name": "Chaos events",
        "expr": "ALERTS{alertname=~\"ChaosPhase1Started|ChaosPhase1Completed|ChaosPhase2Started|ChaosPhase2Completed|AZRotationStarted|AZRotationCompleted|RegionCutoverStarted|RegionCutoverCompleted\",alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}",
        "tagKeys": "phase,az,region"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": ["chaos", "dr"],
      "title": "Region failure runbook",
      "type": "link",
      "url": "/docs/operations/region-failure-recovery.md"
    },
    {
      "icon": "external link",
      "tags": ["chaos"],
      "title": "Why cold DR",
      "type": "link",
      "url": "/docs/operations/why-cold-dr.md"
    }
  ],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "Probe success — continuous timeline",
      "description": "Synthetic probe success rate against the public API. Anchor panel for the chaos demo: a dip during AZ rotation / region cutover should be visible, then recovery to 1.0 within RTO budget.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "avg(probe_success{job=\"blackbox\",instance=~\"https://api.aegis.example.com.*\"})",
          "legendFormat": "probe_success (api)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "green", "value": 0.95}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom"},
        "tooltip": {"mode": "single"}
      }
    },
    {
      "id": 2,
      "title": "ALB HealthyHostCount",
      "description": "Healthy targets behind the regional ALB. During Phase 1 (AZ rotation), expect a dip then recovery to baseline. During Phase 2 (region drill), expect baseline in primary, ramp in DR.",
      "type": "timeseries",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "refId": "A",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Average",
          "dimensions": {"LoadBalancer": "primary"},
          "alias": "primary"
        },
        {
          "refId": "B",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "statistic": "Average",
          "dimensions": {"LoadBalancer": "dr"},
          "alias": "dr"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Pod readiness count",
      "description": "Ready pods per namespace. aegis-app is the stateful tier; api-tier and envoy are stateless. Demo expectation: aegis-app drops during AZ rotation, recovers to baseline.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_pod_status_ready{namespace=~\"aegis-app|api-tier|envoy\",condition=\"true\"})",
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "palette-classic"}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Active alerts",
      "description": "Currently-firing Prometheus alerts. The chaos demo expects a small set of alerts to fire and clear within the RTO budget.",
      "type": "alertlist",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "options": {
        "showOptions": "current",
        "maxItems": 20,
        "sortOrder": 1,
        "dashboardAlerts": false,
        "alertName": "",
        "dashboardTitle": "",
        "tags": [],
        "stateFilter": {
          "firing": true,
          "pending": true
        }
      }
    },
    {
      "id": 5,
      "title": "Demo checkpoints (operator-annotated)",
      "description": "Six checkpoints in the chaos demo: write x2 + read x2 baseline, read x2 post-AZ-rotation, read x2 post-region-cutover. Operator manually fires annotations at each checkpoint via /api/annotations.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {"h": 4, "w": 24, "x": 0, "y": 24},
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"blackbox\",instance=~\"https://api.aegis.example.com.*\"} == 1)",
          "legendFormat": "checkpoints OK"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["chaos", "dr", "availability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "DS_CLOUDWATCH",
        "type": "datasource",
        "query": "cloudwatch"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "Service availability — chaos demo evidence",
  "uid": "service-availability",
  "version": 1,
  "weekStart": ""
}
