# scripts/dev/runbook-config.yaml — shared runbook configuration
#
# Read by all helpers under scripts/dev/runbook-*-bootstrap.sh and by
# scripts/teardown/*.sh. Edit this file when renaming resources; the
# helpers pick up changes on next run.
#
# Forker note: the values below are deliberately namespaced with the
# full repo name `aegis-statefulset` rather than the short `aegis`
# prefix — the short prefix collides with other unrelated projects in
# shared AWS accounts (we found `aegis-emergency-break-glass` and
# `aegis-core` from someone else's project during initial setup).
#
# Required tool: `yq` (https://github.com/mikefarah/yq) — installed via
# brew install yq / apt install yq / equivalent. The runbook-00-bootstrap.sh
# toolchain readiness check verifies its presence.

# ============================================================================
# Resource naming (cross-helper consistency)
# ============================================================================
project:
  name: aegis-statefulset
  # Project name is the canonical prefix for ALL AWS resources created
  # outside of terraform (ECR repos, IAM roles, IAM inline policies, etc.)
  # Inside terraform, the `var.environment` + module conventions handle naming.
# ============================================================================
# ECR / image registry — runbook 01 (Docker build + push + digest)
# ============================================================================
ecr:
  repository: aegis-statefulset-mock # full-prefix; was `aegis-stateful-mock`
images:
  stateful_mock:
    tag: v0.1.0
  distroless_base:
    repository: gcr.io/distroless/static
    variant: nonroot
  nginx:
    tag: "1.27.0"
  envoy:
    tag: v1.30.0
  blackbox_exporter:
    tag: v0.25.0
# ============================================================================
# IAM / OIDC — runbook 03 (GHA OIDC trust)
# ============================================================================
iam:
  role_name: aegis-gha-ci
  policy_name: aegis-gha-ci-plan-only
oidc:
  github_url: https://token.actions.githubusercontent.com
  audience: sts.amazonaws.com
  # GitHub Actions OIDC root-CA thumbprint. AWS auto-resolves now but the
  # create-open-id-connect-provider API still requires a value.
  thumbprint: 6938fd4d98bab03faadb97b34396831e3780aea1
# ============================================================================
# Tagging — required pair for teardown 4-layer safety discovery
# ============================================================================
tags:
  project:
    key: Project
    value: aegis-statefulset
  managed_by:
    key: ManagedBy
    value: terraform
