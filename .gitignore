# =============================================================
# Chaos demo evidence — intermediate output captured Thu morning;
# DR_report.md intermediate + raw evidence captures are not committed
# (final artifact ships as docs/DR_report.pdf which is committed).
# =============================================================
chaos-evidence/

# =============================================================
# Runbook config — working copy generated from .example by
# scripts/dev/runbook-00-bootstrap.sh. The .example is canonical
# committed; the working file allows forker / operator local
# customisation without polluting the repo.
# =============================================================
scripts/dev/runbook-config.yaml

# =============================================================
# Submission PDFs — canonical artefacts attached to the submission
# email AND committed for GitHub browseability (reviewer who clones
# the repo gets the same PDFs without needing the render toolchain).
# The .md sources remain the editable source of truth; the .pdf
# artefacts are regenerated whenever the .md changes (via
# scripts/build/render-submission-pdfs.sh + render-markdown-pdf-chrome.sh
# for SVG-heavy sources) and re-committed.
#
# Intermediate / experimental renders live under intermediate/ and
# stay gitignored. Only the numbered 00-04 canonical PDFs are tracked.
# =============================================================
docs/submission-pdfs/intermediate/
docs/submission-pdfs/*.tmp.pdf

# =============================================================
# Terraform state backend config (generated from
# bootstrap module output; never committed)
# =============================================================
infrastructure/terraform/backend.hcl
infrastructure/terraform/bootstrap/terraform.tfstate
infrastructure/terraform/bootstrap/terraform.tfstate.backup
infrastructure/terraform/bootstrap/.terraform.lock.hcl

# Go build artefact from `go build` in app/ (binary name matches the
# module name in app/go.mod).
app/aegis-stateful-mock

# terraform archive_file output dir (Lambda deployment zips built at
# plan time — regenerated, not source).
infrastructure/terraform/.build/
