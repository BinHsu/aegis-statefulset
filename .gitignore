# =============================================================
# Private context — NEVER committed to public repo
# =============================================================
# These files contain personal AI-tool operating rules and
# assignment-specific context. They are local tooling for development;
# the public submission must not include them.
CLAUDE.md
AGENTS.md
.claude-rules/
.claude/
_context/

# =============================================================
# Terraform
# =============================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.auto.tfvars
# Saved plan output from `terraform plan -out=tfplan` — operator-local,
# regenerated on every apply; do not commit (binary, may contain secrets).
tfplan
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

