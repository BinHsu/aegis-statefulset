# Line endings: enforce LF for shell scripts and YAML
*.sh         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.tf         text eol=lf
*.md         text eol=lf

# Linguist: don't count generated/vendored files in language stats
docs/adr/* linguist-documentation
_context/* linguist-documentation
