# infrastructure/terraform/backend.hcl.example
#
# Copy to backend.hcl after running the bootstrap module, then:
#   terraform init -backend-config=backend.hcl
#
# Easiest path — bootstrap module emits a ready-to-use value:
#   cd infrastructure/terraform/bootstrap
#   terraform output -raw backend_hcl_template > ../backend.hcl
#
# State locking model:
#   `use_lockfile = true` enables terraform 1.10+ native S3 locking via
#   S3 conditional writes (If-None-Match). No separate DynamoDB table
#   required. Lock file `<key>.tflock` lives alongside the state file in
#   the same bucket.

bucket       = "aegis-statefulset-tfstate-<environment>-<aws-account-id>"
key          = "main/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
