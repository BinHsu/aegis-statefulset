flowchart TB
    Trigger["Failure detected<br/>(Prometheus + ALB + Blackbox)"]:::external

    Decide{"What survived?"}:::decision

    subgraph pathA["Path A — etcd corrupted, EBS intact"]
        direction TB
        A1["EBS-tag truth<br/>scripts/dr/rebuild-from-ebs-tags.sh"]:::compute
        A2["Regenerate PV manifests<br/>with claimRef binding"]:::compute
        A3["Helm install at<br/>discovered count"]:::compute
        A_rto["RPO 0 · RTO ~30 min"]:::label
    end

    subgraph pathB["Path B — routing lost, pods intact"]
        direction TB
        B1["Pod inventory truth<br/>scripts/dr/warm-routing-table.sh"]:::compute
        B2["Re-derive override delta<br/>from pod metadata"]:::compute
        B3["Replay into placement table<br/>(DynamoDB Global Tables)"]:::compute
        B_rto["RPO 0 · RTO ~10 min"]:::label
    end

    subgraph pathC["Path C — region failure or backup-only restore"]
        direction TB
        C1["Cross-region BSL<br/>S3 replicated copy"]:::data
        C2["scripts/dr/region-failure-recovery.sh<br/>+ Velero restore in DR region"]:::compute
        C3["Route 53 health-check<br/>flips weighted record"]:::edge
        C_rto["RPO ~5 min · RTO ~50 min<br/>(or 6-12 h if Restic-only)"]:::label
    end

    Healthy(["Service restored<br/>verified via Blackbox probe"]):::external

    Trigger --> Decide
    Decide -->|"EBS intact<br/>etcd corrupted"| pathA
    Decide -->|"routing lost<br/>pods intact"| pathB
    Decide -->|"region failure<br/>OR EBS lost"| pathC

    pathA --> Healthy
    pathB --> Healthy
    pathC --> Healthy

    classDef external fill:#f5f5f5,stroke:#666,color:#333
    classDef decision fill:#fff9c4,stroke:#f9a825,color:#5d4037,stroke-width:2px
    classDef compute fill:#e3f2fd,stroke:#1976d2,color:#0d47a1
    classDef edge fill:#e8f4fd,stroke:#1a73e8,color:#1a3a5f
    classDef data fill:#e0f2f1,stroke:#00695c,color:#004d40
    classDef label fill:#f3e5f5,stroke:#7b1fa2,color:#4a148c,font-style:italic
